/* Hoja de estilos – Control de Acceso QR (Equipo 6 · Magenta) */

QWidget {
    font-family: "Segoe UI", "Noto Sans", sans-serif;
    font-size: 10pt;
    color: #2b2430;
}
QMainWindow, QDialog { background: #faf7fa; }

/* --- Cabecera y menú lateral --- */
#cabecera { background: #8e1a5c; }
#cabeceraTitulo { color: white; font-size: 13pt; font-weight: 600; padding: 8px; }
#cabeceraUsuario { color: #f6d9ea; padding-right: 10px; }
#cabeceraBoton {
    background: transparent; color: white; border: 1px solid #f0b8d6;
    border-radius: 4px; padding: 4px 12px;
}
#cabeceraBoton:hover { background: #a8286f; }

#menuLateral {
    background: #3a1530; color: #f3e6ee; border: none; font-size: 11pt; outline: 0;
}
#menuLateral::item { padding: 12px 16px; border-left: 4px solid transparent; }
#menuLateral::item:hover { background: #4d1d40; }
#menuLateral::item:selected { background: #5e2350; border-left: 4px solid #e0469a; color: white; }

#contenido { background: #faf7fa; }

/* --- Textos --- */
#tituloSeccion { font-size: 13pt; font-weight: 600; color: #8e1a5c; padding: 4px 0; }
#bienvenida { font-size: 12pt; }
#aviso { color: #6e6273; font-size: 9pt; }
#loginTitulo { font-size: 20pt; font-weight: 700; color: #8e1a5c; }
#loginSubtitulo { color: #6e6273; margin-bottom: 10px; }
#loginEstado { min-height: 34px; color: #5a5060; }
#loginEstado[error="true"] { color: #b3261e; font-weight: 600; }

/* --- Botones --- */
QPushButton {
    background: white; border: 1px solid #cdbfca; border-radius: 4px; padding: 6px 14px;
}
QPushButton:hover { border-color: #8e1a5c; }
QPushButton:disabled { color: #a99ea6; border-color: #e3dae1; }
QPushButton#primario, QPushButton#primarioGrande {
    background: #a3206a; color: white; border: 1px solid #8e1a5c; font-weight: 600;
}
QPushButton#primario:hover, QPushButton#primarioGrande:hover { background: #8e1a5c; }
QPushButton#primarioGrande { font-size: 13pt; padding: 12px 34px; }
QPushButton#peligro { color: #b3261e; border-color: #e7b7b3; }
QPushButton#peligro:hover { background: #fbeceb; }

/* --- Entradas y tablas --- */
QLineEdit, QComboBox, QSpinBox, QDateEdit, QTimeEdit {
    background: white; border: 1px solid #cdbfca; border-radius: 4px; padding: 4px 6px;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDateEdit:focus, QTimeEdit:focus {
    border-color: #a3206a;
}
QGroupBox {
    border: 1px solid #e3d5df; border-radius: 6px; margin-top: 14px; padding: 10px; background: white;
}
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 4px; color: #8e1a5c; font-weight: 600; }
QTableView {
    background: white; alternate-background-color: #fbf5f9; border: 1px solid #e3d5df;
    gridline-color: #efe6ec; selection-background-color: #e9c3d9; selection-color: #2b2430;
}
QHeaderView::section {
    background: #f3e6ee; padding: 6px; border: none; border-right: 1px solid #e3d5df; font-weight: 600;
}

/* --- Tarjetas de indicadores --- */
#tarjeta { background: white; border: 1px solid #e3d5df; border-top: 4px solid #a3206a; border-radius: 6px; }
#tarjetaValor { font-size: 26pt; font-weight: 700; color: #8e1a5c; }
#tarjetaTitulo { color: #6e6273; }

/* --- Lector QR --- */
#video { background: #1e1a20; color: #d9cfd6; border-radius: 6px; }
#resultadoEspera  { background: #f3e6ee; color: #5e2350; border-radius: 8px; padding: 12px; font-size: 13pt; }
#resultadoPermitido { background: #1f7a3d; color: white; border-radius: 8px; padding: 12px; }
#resultadoDenegado  { background: #b3261e; color: white; border-radius: 8px; padding: 12px; }
#resultadoAviso     { background: #c98a00; color: white; border-radius: 8px; padding: 12px; }

/* --- Diálogo de QR --- */
#qrTitular { font-size: 13pt; font-weight: 600; }
#qrCodigo { font-family: Consolas, monospace; font-size: 12pt; color: #8e1a5c; }
#qrDetalle { color: #6e6273; }
