# Copie este archivo como ".env" y escriba sus datos. NUNCA suba el .env a GitHub.

# Cadena de conexión de Neon (botón "Connect" del proyecto)
DATABASE_URL=postgresql://usuario:contraseña@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Clave para firmar las sesiones: cualquier texto largo y aleatorio
SECRET_KEY=cambie-esto-por-un-texto-largo-y-aleatorio

# En su computadora (http) déjelo en 0; en la nube (https) debe ser 1
COOKIE_SEGURA=0
